<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', flexDirection: 'column', fontFamily: '"Microsoft YaHei","Source Han Sans SC","Noto Sans SC",sans-serif' }}>
  <Box style={{ height: 80, background: '#1E4FA8', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', paddingLeft: 40, paddingRight: 40 }}>
    <Text style={{ fontSize: 26, fontWeight: 'bold', color: '#FFFFFF' }}>37 模型总榜：收缩判别分析居首，深度学习垫底</Text>
    <Text style={{ fontSize: 14, color: 'rgba(255,255,255,0.75)' }}>CRT 应答预测 · AI 模型基准对比</Text>
  </Box>
  <Box style={{ flex: 1, paddingLeft: 40, paddingRight: 40, paddingTop: 18, paddingBottom: 18, background: '#FFFFFF', flexDirection: 'row', gap: 26 }}>
    <Box style={{ width: 640 }}>
      <Box style={{ flexDirection: 'row', alignItems: 'flex-end' }}>
        <Text style={{ fontSize: 84, fontWeight: 'bold', color: '#1E4FA8', lineHeight: 1 }}>0.809</Text>
        <Box style={{ marginLeft: 20, marginBottom: 8 }}>
          <Text style={{ fontSize: 21, fontWeight: 'bold', color: '#1A2230' }}>LDA_Shrinkage 折均 AUC</Text>
          <Text style={{ fontSize: 13, color: '#8B97A8', marginTop: 2 }}>25 个外层折均值 ± SD 0.047</Text>
        </Box>
      </Box>
      <Table
        style={{ width: '100%', height: 350, marginTop: 10 }}
        defaultTextStyle={{ fontSize: 14.5, textAlign: 'center', color: '#1A2230' }}
        defaultCellStyle={{
          border: {
            left: { width: 1, color: '#E5E7EB' },
            right: { width: 1, color: '#E5E7EB' },
            top: { width: 1, color: '#E5E7EB' },
            bottom: { width: 1, color: '#E5E7EB' },
          },
        }}
        cells={[
          [
            { text: '#', textStyle: { bold: true, color: '#FFFFFF' }, cellStyle: { background: { color: '#1E4FA8' } } },
            { text: '模型', textStyle: { bold: true, color: '#FFFFFF' }, cellStyle: { background: { color: '#1E4FA8' } } },
            { text: '方法族', textStyle: { bold: true, color: '#FFFFFF' }, cellStyle: { background: { color: '#1E4FA8' } } },
            { text: '折均 AUC', textStyle: { bold: true, color: '#FFFFFF' }, cellStyle: { background: { color: '#1E4FA8' } } },
          ],
          [
            { text: '1', textStyle: { bold: true }, cellStyle: { background: { color: '#E8EFF8' } } },
            { text: 'LDA_Shrinkage', textStyle: { bold: true }, cellStyle: { background: { color: '#E8EFF8' } } },
            { text: '线性/正则', cellStyle: { background: { color: '#E8EFF8' } } },
            { text: '0.809', textStyle: { bold: true, color: '#1E4FA8' }, cellStyle: { background: { color: '#E8EFF8' } } },
          ],
          ['2', 'Stacking_Logit', '集成之集成', '0.802'],
          ['3', 'GaussianProcess_RBF', '核方法/贝叶斯', '0.801'],
          ['4', 'SuperLearner_NNLS', '集成之集成', '0.800'],
          ['5', 'SVM_linear', '核方法/贝叶斯', '0.800'],
          ['6', 'SVM_poly', '核方法/贝叶斯', '0.797'],
          ['7', 'ExtraTrees', '树模型与集成', '0.795'],
          ['19', 'LASSO 基线（已发表）', '线性/正则', '0.746'],
          ['33', 'TabNet_Deep', '深度学习', '0.616'],
          ['37', 'MLP', '深度学习', '0.546'],
        ]}
      />
    </Box>
    <Box style={{ flex: 1, alignItems: 'center', justifyContent: 'center' }}>
      <Box style={{ width: 470, background: '#FFFFFF', border: '1px solid #D6DCE5', borderRadius: 12, padding: 14 }}>
        <Image src="assets/roc_37.png" style={{ width: 442, height: 442, objectFit: 'contain' }} />
        <Text style={{ fontSize: 13, color: '#8B97A8', textAlign: 'center', marginTop: 8 }}>前 12 名折外预测合并 ROC · 已发表 LASSO 基线折均 0.746，列第 19 / 37 位</Text>
      </Box>
    </Box>
  </Box>
  <Box style={{ height: 40, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', paddingLeft: 40, paddingRight: 40, borderTop: '1px solid #E5E7EB', background: '#F7F9FC' }}>
